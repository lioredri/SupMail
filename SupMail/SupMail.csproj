<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWPF>true</UseWPF>
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
		<EnableDynamicLoading>true</EnableDynamicLoading>
		<ApplicationIcon>Assets\logo1.ico</ApplicationIcon>
		<Version>2.0</Version>
		<!-- OneDrive Client ID - injected at build time via -p:OneDriveClientId=xxx -->
		<OneDriveClientId Condition="'$(OneDriveClientId)' == ''"></OneDriveClientId>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Azure.Identity" Version="1.21.0" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.8" />
		<PackageReference Include="Microsoft.Graph" Version="6.1.0" />
		<PackageReference Include="Microsoft.Identity.Client" Version="4.83.1" />
		<PackageReference Include="Microsoft.Identity.Client.Desktop" Version="4.83.1" />
		<PackageReference Include="Microsoft.Identity.Client.Extensions.Msal" Version="4.83.1" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
	</ItemGroup>

	<ItemGroup>
		<Resource Include="Assets\**" />
	</ItemGroup>

	<!-- Generate a constants file with embedded config -->
	<Target Name="GenerateAppSecrets" BeforeTargets="CoreCompile">
		<PropertyGroup>
			<AppSecretsFile>$(IntermediateOutputPath)AppSecrets.g.cs</AppSecretsFile>
		</PropertyGroup>
		<ItemGroup>
			<Compile Include="$(AppSecretsFile)" Condition="Exists('$(AppSecretsFile)')" />
		</ItemGroup>
		<WriteLinesToFile
			File="$(AppSecretsFile)"
			Overwrite="true"
			Lines="namespace SupMail.Services { internal static class AppSecrets { public const string OneDriveClientId = &quot;$(OneDriveClientId)&quot;%3B } }" />
		<ItemGroup>
			<Compile Include="$(AppSecretsFile)" />
		</ItemGroup>
	</Target>

</Project>
